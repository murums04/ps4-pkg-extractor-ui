+bool PKG::IsSafePathComponent(std::string_view name) {
+    if (name.empty() || name == "." || name == ".." || name.back() == '.' || name.back() == ' ') {
+        return false;
+    }
+    for (unsigned char c : name) {
+        if (c < 0x20 || std::string_view("<>:\"/\\|?*").find(c) != std::string_view::npos) {
+            return false;
+        }
+    }
+    std::string stem(name.substr(0, name.find('.')));
+    while (!stem.empty() && stem.back() == ' ') {
+        stem.pop_back();
+    }
+    for (char& c : stem) {
+        if (c >= 'a' && c <= 'z') {
+            c -= 'a' - 'A';
+        }
+    }
+    if (stem == "CON" || stem == "PRN" || stem == "AUX" || stem == "NUL" ||
+        stem == "CONIN$" || stem == "CONOUT$" || stem == "CLOCK$") {
+        return false;
+    }
+    if (stem.starts_with("COM") || stem.starts_with("LPT")) {
+        const auto suffix = std::string_view(stem).substr(3);
+        if ((suffix.size() == 1 && suffix[0] >= '1' && suffix[0] <= '9') ||
+            suffix == "\xC2\xB9" || suffix == "\xC2\xB2" || suffix == "\xC2\xB3") {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool PKG::IsSafeOutputPath(const std::filesystem::path& root, const std::filesystem::path& path) {
+    std::error_code error;
+    auto current = root;
+    const auto relative = path.lexically_relative(root);
+    if (relative.empty()) {
+        return path == root;
+    }
+    for (const auto& part : relative) {
+        if (part == "..") {
+            return false;
+        }
+        current /= part;
+#ifdef _WIN32
+        const auto attributes = GetFileAttributesW(current.c_str());
+        if (attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_REPARSE_POINT)) {
+            return false;
+        }
+#endif
+        if (std::filesystem::is_symlink(std::filesystem::symlink_status(current, error))) {
+            return false;
+        }
+        if (error && error != std::errc::no_such_file_or_directory) {
+            return false;
+        }
+        error.clear();
+    }
+    const auto resolved = std::filesystem::weakly_canonical(path, error);
+    if (error) {
+        return false;
+    }
+    auto component = resolved.begin();
+    for (const auto& root_component : root) {
+        if (component == resolved.end() || *component++ != root_component) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool PKG::IsWithinExtractionRoot(const std::filesystem::path& path) const {
+    return IsSafeOutputPath(extract_path, path);
+}
+
+static bool ReadPfsDirent(std::span<const char> block, size_t offset, Dirent& entry) {
+    constexpr size_t header_size = offsetof(Dirent, name);
+    if (offset > block.size() || block.size() - offset < header_size) {
+        return false;
+    }
+    std::memcpy(&entry, block.data() + offset, header_size);
+    if (entry.ino == 0) {
+        return true;
+    }
+    if (entry.ino < 0 || entry.namelen <= 0 || entry.namelen > sizeof(entry.name) ||
+        entry.entsize < header_size + entry.namelen || entry.entsize > block.size() - offset) {
+        return false;
+    }
+    std::memcpy(entry.name, block.data() + offset + header_size, entry.namelen);
+    return true;
 }
 

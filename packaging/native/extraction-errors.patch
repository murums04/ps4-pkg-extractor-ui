+bool PKG::ExtractFiles(const int index, std::string& failreason) {
+    const auto& entry = fsTable[index];
+    if (entry.type != PFS_FILE) {
+        return true;
+    }
+    if (entry.inode >= iNodeBuf.size() || !extractPaths.contains(entry.inode)) {
+        failreason = "Invalid PFS file inode";
+        return false;
+    }
+    const auto& node = iNodeBuf[entry.inode];
+    const auto& path = extractPaths.at(entry.inode);
+    if (!IsSafePathComponent(entry.name) || !IsWithinExtractionRoot(path)) {
+        failreason = "PFS output path escapes extraction root";
+        return false;
+    }
+    if (node.Size < 0 || node.Blocks != (static_cast<u64>(node.Size) + 0xFFFF) / 0x10000 ||
+        static_cast<u64>(node.loc) + node.Blocks >= sectorMap.size()) {
+        failreason = "Invalid PFS file size or block count";
+        return false;
+    }
+    Common::FS::IOFile output(path, Common::FS::FileAccessMode::Write);
+    if (!output.IsOpen()) {
+        failreason = "Failed to open PFS output file";
+        return false;
+    }
+    Common::FS::IOFile pkgFile(pkgpath, Common::FS::FileAccessMode::Read);
+    if (!pkgFile.IsOpen()) {
+        failreason = "Failed to open PKG payload";
+        return false;
+    }
+    u64 remaining = node.Size;
+    std::vector<char> decompressedData(0x10000);
+    for (u32 j = 0; j < node.Blocks; j++) {
+        const u64 sectorOffset = sectorMap[node.loc + j];
+        const u64 sectorEnd = sectorMap[node.loc + j + 1];
+        if (sectorEnd <= sectorOffset || sectorEnd - sectorOffset > 0x10000) {
+            failreason = "Invalid PFS payload block size";
+            return false;
+        }
+        const u64 sectorSize = sectorEnd - sectorOffset;
+        const u64 offset = pfsc_offset + sectorOffset;
+        const u64 previousData = offset % 0x1000;
+        const u64 readSize = (previousData + sectorSize + 0xFFF) & ~u64{0xFFF};
+        std::vector<u8> encrypted(readSize);
+        std::vector<u8> decrypted(readSize);
+        if (!pkgFile.Seek(pkgheader.pfs_image_offset + offset - previousData) ||
+            pkgFile.Read(encrypted) != readSize) {
+            failreason = "Failed to read complete PFS payload block";
+            return false;
+        }
+        crypto.decryptPFS(dataKey, tweakKey, encrypted, decrypted, offset / 0x1000);
+        std::span<char> compressedData(reinterpret_cast<char*>(decrypted.data() + previousData),
+                                       sectorSize);
+        if (sectorSize == 0x10000) {
+            std::memcpy(decompressedData.data(), compressedData.data(), decompressedData.size());
+        } else if (!DecompressPFSC(compressedData, decompressedData)) {
+            failreason = "Failed to decompress PFS payload block";
+            return false;
+        }
+        const size_t writeSize = std::min<u64>(remaining, decompressedData.size());
+        if (output.WriteSpan<char>(std::span<const char>(decompressedData.data(), writeSize)) != writeSize) {
+            failreason = "Failed to write complete PFS output file";
+            return false;
+        }
+        remaining -= writeSize;
+    }
+    if (!output.Flush()) {
+        failreason = "Failed to flush PFS output file";
+        return false;
+    }
+    if (!output.Close()) {
+        failreason = "Failed to close PFS output file";
+        return false;
+    }
+    return true;
+}
